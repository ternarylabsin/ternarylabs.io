  "sections": {
    "fieldUse": {
      "body": "In the field, these are what keep a crossing, harvest run, or recovery attempt alive. The item is intentionally simple because the drama comes from how scarce and necessary it is."
    },
    "ingestion": {
      "foodType": "Fluid, Processed",
      "nutrition": 0.01,
      "outcomeDoers": [
        {
          "need": "SoA_Water",
          "offset": 0.45
        }
      ],
      "preferability": "NeverForNutrition"
    },
    "logistics": {
      "body": "Stacks, storage, and hauling all matter more once water becomes a first-class survival resource. A colony with enough rations is stable. A colony with rations in the wrong place is not."
    },
    "overview": {
      "body": "A water ration is the smallest complete answer to Arrakis. It is sealed, portable, and useful anywhere a pawn can stand long enough to drink."
    }
  },
