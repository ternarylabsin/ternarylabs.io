  "sections": {
    "fieldUse": {
      "body": "Caravans draw from carried water, and work parties need access to supplies on the map. Food, tea and an empty container do not replace a drinking ration."
    },
    "ingestion": {
      "foodType": "Fluid, Processed",
      "nutrition": 0.01,
      "outcomeDoers": [
        {
          "need": "SoA_Water",
          "offset": 0.45
        }
      ],
      "preferability": "NeverForNutrition"
    },
    "logistics": {
      "body": "Cisterns provide compact water-only storage protected from deterioration. Colonists still haul and drink the sealed items. Distribute reserves so that a blocked doorway or an exposed hauling route does not cut off an entire occupied area."
    },
    "overview": {
      "body": "Rations supply the separate water need of colonists and supported Arrakis animals. They are also used by irrigated growers and water-fed coolers, creating demand beyond the number of thirsty mouths."
    }
  },
