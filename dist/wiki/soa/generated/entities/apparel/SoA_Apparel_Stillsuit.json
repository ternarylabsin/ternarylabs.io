    "craftsmanship": {
      "body": "Because water retention scales with the quality and condition of the individual garment, a stillsuit feels like equipment worth making well and maintaining. That keeps tailoring relevant even before the colony has wealth to spare."
    },
    "creation": {
      "costList": {
        "ComponentIndustrial": 2
      },
      "costStuffCount": 80,
      "defaultStuff": "Synthread",
      "recipeUsers": [
