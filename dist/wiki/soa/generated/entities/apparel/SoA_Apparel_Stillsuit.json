        "Leathery"
      ],
      "workToBuild": null,
      "workToMake": 9000
    },
    "overview": {
      "body": "The stillsuit is the visual and mechanical center of the Arrakis campaign. It tells the player immediately that this is not a temperate-colony logistics game. Survival begins with sealed clothing and disciplined movement."
    },
    "statOffsets": {
      "SoA_WaterRetention": 0.6
    },
    "survivalRole": {
      "body": "In practical terms, the suit buys time. Colonists can work longer between drinks, cross more exposed terrain, and survive heat bands that would otherwise turn routine labor into a water crisis."
    },
    "water": {
      "qualityScalesOwnContributionOnly": true,
      "waterRetention": 0.6
    }
  },
